<div class="box">
  <h3 class="subtitle">Comentarios</h3>
  <% listaComentarios.forEach(comentario => { %>
    <article class="media">
      <div class="media-content">
        <div class="content">
          <p>
            <strong><%= comentario.username %></strong>
            <br>
            <%= comentario.comment %>
          </p>
        </div>
      </div>
    </article>
  <% }) %>
</div>

\cf0 \'977 Raz\'f3n social de los proveedores que han realizado entregas tanto al proyecto 'Vamos M\'e9xico' como al proyecto 'Quer\'e9taro Limpio'.\
SELECT RazonSocial \
FROM Proveedores, Entregan , Proyectos\
WHERE (Proveedores.RFC = Entregan.RFC AND Entregan.Numero = Proyectos.Numero) AND (Proyectos.Denominaci\'f3n = \'91Vamos M\'e9xico' OR Proyectos.Denominaci\'f3n = \'91Quer\'e9taro Limpio\'92)\
\
\'978 Descripci\'f3n de los materiales que nunca han sido entregados al proyecto 'CIT Yucat\'e1n'.\
Select descripcion \
FROM materiales, entregan \
WHERE clave NOT IN \
(SELECT Clave FROM Materiales, Entregan, Proyecto \
WHERE Materiales.clave = Entregan.clave AND Entregan.Numero = Proyectos.Numero) AND Proyectos.Denominaci\'f3n = \'91CIT Yucat\'e1n' \
\
\'979 Raz\'f3n social y promedio de cantidad entregada de los proveedores cuyo promedio de cantidad entregada es mayor al promedio de la cantidad entregada por el proveedor con el RFC 'VAGO780901'.\
SELECT RazonSocial, AVG(cantidad)\
FROM Proveedores as P, Entregan as E\
WHERE P.RFC = E.RFC\
GROUPBY RFC\
HAVING AVG(cantidad) > (SELECT cantidad FROM Entregan WHERE RFC = \'91VAGO780901\'92\
\
\'9710 RFC, raz\'f3n social de los proveedores que participaron en el proyecto 'Infonavit Durango' y cuyas cantidades totales entregadas en el 2000 fueron mayores a las cantidades totales entregadas en el 2001.\
\
SELECT RFC, raz\'f3nsocial\
FROM proveedores as P, Entregan as E, Proyectos as Pr\
WHERE (Pr.Numero = E.numero AND E.RFC = P.RFC) AND (Proyectos.Denominaci\'f3n = \'91Infonavit Durango\'92) \
GROUP BY P.rfc, P.razonsocial\
HAVING (SELECT SUM(cantidad) FROM Entregan E WHERE E2.RFC AND E2 .Fecha BETWEEN \'9201/01/2000\'92 AND \'9231/12/2000\'92 >\
(SELECT SUM(Cantidad) FROM Entregan E3 WHERE E3.RFC = P.RFC AND E3.Fecha BETWEEN \'9201/01/2001\'92 AND \'9231/12/2001\'92\
\

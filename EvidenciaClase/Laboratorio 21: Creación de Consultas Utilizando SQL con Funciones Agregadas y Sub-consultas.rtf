\f0\fs24 \cf0 \'971. \
SELECT SUM(cantidad), SUM(cantidad* (costo + impuesto)) FROM Materiales between \'9201/01/1997\'92 AND 31/01/1997\'92\
\
\'972. Para cada proveedor, obtener la raz\'f3n social del proveedor, n\'famero de entregas e importe total de las entregas realizadas.\
SELECT RazonSocial, SUM(Entregan), SUM(cantidad* (costo + impuesto))\
FROM Proveedor as P, Entregan as E, Materiales as M\
WHERE P.RFC = E.RFC AND E.clave = M.Clave\
GROUPBY(Razon social)\
\
